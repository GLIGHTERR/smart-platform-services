NODE_ENV=development
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
RENTER_API_PORT=3001
OWNER_API_PORT=3002
ADMIN_API_PORT=3003
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=smart_platform
DATABASE_USER=smart_platform
DATABASE_PASSWORD=local-only-change-me
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_SIZE=10
JWT_ACCESS_SECRET=local-access-secret-change-me-32-characters
JWT_REFRESH_SECRET=local-refresh-secret-change-me-32-characters
JWT_ISSUER=smart-platform-services
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
OTP_HASH_SECRET=local-otp-secret-change-me-32-characters
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_REQUEST_LIMIT_PER_HOUR=5
OTP_IP_LIMIT_PER_HOUR=20
OTP_DEVICE_LIMIT_PER_HOUR=20
LOGIN_FAILURE_LIMIT=5
LOGIN_ABUSE_LIMIT=20
LOGIN_WINDOW_SECONDS=900
LOGIN_LOCK_SECONDS=900
EMAIL_DELIVERY_MODE=console
OTP_DELIVERY_MODE=console
LEGACY_PHONE_FLOWS_ENABLED=false
