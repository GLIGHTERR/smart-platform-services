{
  "name": "smart-platform-services",
  "version": "0.1.0",
  "description": "Smart Platform NestJS modular backend services monorepo",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "npm run build:renter && npm run build:owner && npm run build:admin && npm run build:worker",
    "build:renter": "nest build renter-api",
    "build:owner": "nest build owner-api",
    "build:admin": "nest build admin-api",
    "build:worker": "nest build worker",
    "start:renter": "nest start renter-api --watch",
    "start:owner": "nest start owner-api --watch",
    "start:admin": "nest start admin-api --watch",
    "start:worker": "nest start worker --watch",
    "start:prod:renter": "node dist/apps/renter-api/main.js",
    "start:prod:owner": "node dist/apps/owner-api/main.js",
    "start:prod:admin": "node dist/apps/admin-api/main.js",
    "start:prod:worker": "node dist/apps/worker/main.js",
    "lint": "eslint .",
    "format": "prettier --write \"{apps,libs,database,test}/**/*.{ts,json,md}\" \"*.{json,md,yml,yaml}\"",
    "format:check": "prettier --check \"{apps,libs,database,test}/**/*.{ts,json,md}\" \"*.{json,md,yml,yaml}\"",
    "test": "jest --runInBand",
    "test:cov": "jest --runInBand --coverage",
    "db:migration:run": "typeorm-ts-node-commonjs -d database/data-source.ts migration:run",
    "db:migration:revert": "typeorm-ts-node-commonjs -d database/data-source.ts migration:revert",
    "db:migration:show": "typeorm-ts-node-commonjs -d database/data-source.ts migration:show",
    "db:seed": "ts-node -r tsconfig-paths/register database/seeds/roles.seed.ts",
    "db:verify": "ts-node -r tsconfig-paths/register database/verify-schema.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/typeorm": "^11.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.2",
    "helmet": "^8.3.0",
    "joi": "^18.2.5",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.2.3",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "jest": "^30.4.2",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0"
  }
}
